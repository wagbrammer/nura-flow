# .env.example – copie para .env e preencha os valores reais
# ------------------------------------------------------------
# Autenticação NuRa (exemplo)
NURA_AUTH_USER="your_username"
NURA_AUTH_PASSWORD_HASH="your_pbkdf2_hash"
NURA_AUTH_SESSION_SECRET="your_session_secret"

# Alias de compatibilidade (mantidos para implantações antigas)
ROBUSTEC_AUTH_USER="${NURA_AUTH_USER}"
ROBUSTEC_AUTH_PASSWORD_HASH="${NURA_AUTH_PASSWORD_HASH}"
ROBUSTEC_AUTH_SESSION_SECRET="${NURA_AUTH_SESSION_SECRET}"

# Chave Gemini (IA) – opcional
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# URL da aplicação (usado em redirects internos)
APP_URL="http://localhost:3000"

# Conexão ao PostgreSQL (Supabase ou outro)
# Substitua YOUR_PASSWORD e YOUR_HOST pelos valores reais
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres"

# Telegram bot (se usar integrações)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# OpenRouter AI (opcional)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Configurações de e‑mail (IMAP) – opcional
EMAIL_HOST=""
EMAIL_PORT=993
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_SECURITY="ssl"

# Paths de arquivos de calendário (ICS)
CALENDAR_ICS_PATHS=""

# Drive local (diretório relativo ao projeto)
DRIVE_LOCAL_PATH="drive"
