# NuRa Flow Environment Variables
# Copy this file to .env and fill in the values

# Authentication
NURA_AUTH_USER="your_username"
NURA_AUTH_PASSWORD_HASH="pbkdf2_sha256_hash_here"
NURA_AUTH_SESSION_SECRET="your_session_secret"

# Google Cloud (for Calendar integration)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# For production, change to your actual domain:
# GOOGLE_REDIRECT_URI="https://your-app.fly.dev/api/auth/google/callback"

# AI (optional - OpenRouter recommended for free tier)
OPENROUTER_API_KEY=""

# Email IMAP Configuration (optional)
EMAIL_HOST="imap.gmail.com"
EMAIL_PORT=993
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_SECURITY="ssl"

# Calendar ICS Files (optional - for local .ics files)
CALENDAR_ICS_PATHS="calendarios/meu-calendario.ics"

# Drive Local Path (optional)
DRIVE_LOCAL_PATH="drive/"

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=""

# App URL (required for OAuth redirects)
APP_URL="http://localhost:3000"
# For production: APP_URL="https://your-app.fly.dev"
